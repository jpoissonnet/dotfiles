#!/bin/bash
set -euo pipefail

fail_missing() {
  echo "$1 is missing after install" >&2
  exit 1
}

if ! command -v rustup >/dev/null 2>&1; then
  echo "Installing Rust via rustup..."
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
fi
# rustup is installed with --no-modify-path, so the same run must load cargo.
if [ -f "$HOME/.cargo/env" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.cargo/env"
fi
export PATH="$HOME/.cargo/bin:$PATH"
command -v cargo >/dev/null 2>&1 || fail_missing cargo

if ! command -v unzip >/dev/null 2>&1; then
  echo "unzip is required for the Bun installer" >&2
  exit 1
fi

if ! command -v bun >/dev/null 2>&1; then
  echo "Installing Bun..."
  curl -fsSL https://bun.sh/install | bash
fi
export PATH="$HOME/.bun/bin:$PATH"
command -v bun >/dev/null 2>&1 || fail_missing bun

if ! command -v deno >/dev/null 2>&1; then
  echo "Installing Deno..."
  curl -fsSL https://deno.land/install.sh | sh
fi
if [ -f "$HOME/.deno/env" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.deno/env"
fi
command -v deno >/dev/null 2>&1 || fail_missing deno

if ! command -v fnm >/dev/null 2>&1; then
  echo "Installing fnm..."
  curl -fsSL https://fnm.vercel.app/install | bash -s -- --skip-shell --install-dir "$HOME/.local/share/fnm"
fi
export PATH="$HOME/.local/share/fnm:$PATH"
command -v fnm >/dev/null 2>&1 || fail_missing fnm
eval "$(fnm env --shell bash)"
if ! command -v node >/dev/null 2>&1; then
  echo "Installing Node via fnm..."
  fnm install --lts
  eval "$(fnm env --shell bash)"
fi
command -v node >/dev/null 2>&1 || fail_missing node

if ! command -v pnpm >/dev/null 2>&1; then
  echo "Enabling pnpm via corepack..."
  corepack enable
  corepack prepare pnpm@latest --activate
fi
command -v pnpm >/dev/null 2>&1 || fail_missing pnpm

if ! command -v uv >/dev/null 2>&1; then
  echo "Installing uv..."
  curl -fsSL https://astral.sh/uv/install.sh | sh
fi
export PATH="$HOME/.local/bin:$PATH"
command -v uv >/dev/null 2>&1 || fail_missing uv

if ! command -v stylua >/dev/null 2>&1; then
  echo "Installing stylua..."
  cargo install stylua --locked
fi
command -v stylua >/dev/null 2>&1 || fail_missing stylua
