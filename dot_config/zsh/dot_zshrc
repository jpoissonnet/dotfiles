# Enable Powerlevel10k instant prompt. Should stay close to the top of .zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

[[ -d $ZDOTDIR/completions ]] && fpath=("$ZDOTDIR/completions" ${fpath:#"$ZDOTDIR/completions"})

export EDITOR="nvim"
export BROWSER=''

export PATH=$HOME/bin:/usr/local/bin:$PATH
export PATH=$HOME/.local/bin:$PATH

export ZPWR_EXPAND_TO_HISTORY=true
export ZPWR_EXPAND_PRE_EXEC_NATIVE=true
export ZPWR_EXPAND_BLACKLIST=(grep k)

source $ZDOTDIR/.antidote/antidote.zsh
antidote load $ZDOTDIR/.zsh_plugins.txt

# Drop-ins, in numeric order. Explicit rather than via zephyr's confd plugin,
# which hooked this to precmd, so no non-prompt shell ever saw it. Sourcing
# after `antidote load` keeps the order confd produced.
for f in $ZDOTDIR/conf.d/*.zsh(N); do
  source $f
done

# Secrets (API keys, tokens) - untracked, machine-local.
[[ -f ~/.secrets.zsh ]] && source ~/.secrets.zsh

# To customize prompt, run `p10k configure` or edit $ZDOTDIR/.p10k.zsh.
[[ ! -f $ZDOTDIR/.p10k.zsh ]] || source $ZDOTDIR/.p10k.zsh
