#!/bin/bash
set -euo pipefail

# Arch has no aarch64 package for either of these, so they come from upstream.
# Everything else in the toolchain is a package; see 10-packages-*.sh.

if ! command -v deno >/dev/null 2>&1; then
  echo "Installing Deno..."
  curl -fsSL https://deno.land/install.sh | sh
fi
export PATH="$HOME/.deno/bin:$PATH"
command -v deno >/dev/null 2>&1 || { echo "deno is missing after install" >&2; exit 1; }

if ! command -v bun >/dev/null 2>&1; then
  echo "Installing Bun..."
  curl -fsSL https://bun.sh/install | bash
fi
export PATH="$HOME/.bun/bin:$PATH"
command -v bun >/dev/null 2>&1 || { echo "bun is missing after install" >&2; exit 1; }
